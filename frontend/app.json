{
  "expo": {
    "name": "Oromona",
    "slug": "oromona",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/oromona-icon-1024.png",
    "scheme": "oromona",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Capture body and clothing photos for try-on.",
        "NSPhotoLibraryUsageDescription": "Pick photos for try-on and listings."
      },
      "bundleIdentifier": "com.emergent.fitfinderapp.leor5k"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/oromona-adaptive-fg.png",
        "backgroundColor": "#2A0F0A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.emergent.fitfinderapp.leor5k"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/oromona-icon-1024.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/oromona-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2A0F0A"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos for try-on and listings.",
          "cameraPermission": "Capture body and clothing photos for try-on."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
